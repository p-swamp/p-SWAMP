"""The __LABEL__ module: one ``PmuFrame`` in, one ``__NAME__Result`` out.

The analysis is a placeholder: the station with the highest frequency in each
frame. It is a plain function, ``highest_frequency``; ``process`` only adapts a
frame to it and its answer to a result. Replace the function and the
``__NAME__Body`` it fills with yours, keeping that split.
"""

from typing import Literal

from pydantic import BaseModel, Field

from pswamp_core.messages import PmuFrame, ResultEnvelope
from pswamp_core.modules import Module

__all__ = ["__NAME__Body", "__NAME__Module", "__NAME__Result", "highest_frequency"]


def highest_frequency(stations: list[str], frequencies: list[float | None]) -> tuple[str, float] | None:
    """The station with the highest frequency, and that frequency; ``None``
    when no station has a value."""
    readings = [(hz, station) for station, hz in zip(stations, frequencies) if hz is not None]
    if not readings:
        return None
    hz, station = max(readings)
    return station, hz


class __NAME__Body(BaseModel):
    station: str = Field(description="The station with the highest frequency in the frame.")
    frequency_hz: float = Field(description="Its frequency, in Hz.")


class __NAME__Result(ResultEnvelope[__NAME__Body]):
    version: Literal["v1"] = "v1"


class __NAME__Module(Module):
    name = "__SLUG__"
    input_model = PmuFrame
    output_model = __NAME__Result

    # The next three matter only for an analysis that needs several inputs
    # before it can answer (a window). This placeholder answers from one frame,
    # so they are off. doc/module-cookbook.md, "Caching and windowed
    # algorithms", shows them in use.

    #: How many seconds of unbroken input the analysis needs before its answer
    #: counts. 0 means every input gives an answer on its own. While the module
    #: warms up, ``process`` is still called with every input, so it can fill
    #: its window, but what it returns is not published. The warm-up starts at
    #: the module's first input and starts again after every break (see
    #: ``reset``). It is counted in the data's own time, not on the clock.
    warm_up_s = 0.0

    #: Set it to ``True`` to let the server keep this module's results for a
    #: recording and show them again when any client is at the same instant.
    #: Setting it is a promise: the same inputs always give the same result. So
    #: a result depends only on the recording and the instant, never on the
    #: client, on a command, on the clock, on chance, or on anything else
    #: outside the inputs. Leave it ``False``, the default, for an analysis
    #: that is not deterministic. Nothing checks this promise: a cached result
    #: from one run is shown in place of what another run would have computed.
    cache_results = False

    def reset(self) -> None:
        """Called when the input stops being continuous: the player moved (a
        seek, a step back, a loop, another source) or a frame went missing.
        Throw away everything built from earlier inputs, the window above all.
        Keep settings. It is not called before the first input, and a module
        never calls it itself.

        Nothing to throw away here: this analysis answers from one frame."""

    async def process(self, frame: PmuFrame) -> __NAME__Body | None:
        columns = frame.header.columns(measurement="f")
        peak = highest_frequency([frame.header.station[i] for i in columns], [frame.values[i] for i in columns])
        if peak is None:
            return None  # publish nothing for this frame
        station, hz = peak
        return __NAME__Body(station=station, frequency_hz=hz)
