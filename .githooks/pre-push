#!/bin/sh
# Run the static checks (`pswamp check`) before every push, so broken code doesn't
# reach main. CI runs the same command after the push, but this hook is the fast
# gate: it fails in seconds on your machine instead of minutes into a pipeline.
# Git for Windows runs hooks through its bundled sh, so this works there too.
#
# Activate once per clone:  git config core.hooksPath .githooks
# Bypass for a single push: git push --no-verify
#
# GUI git frontends may start hooks with a minimal PATH; ~/.local/bin is where the
# uv installer puts uv. (pswamp repairs the rest of PATH, node included, itself.)
PATH="$HOME/.local/bin:$PATH"
exec uv run pswamp check
