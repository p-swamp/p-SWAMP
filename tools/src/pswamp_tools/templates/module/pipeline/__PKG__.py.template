"""What the __LABEL__ pipeline is made of: the ``__SLUG__.*`` topics, the
configured sources, and the module. A worker hosts the module with
``PSWAMP_WORKER_PIPELINES=pswamp_modules.pipelines.__PKG__:PIPELINE``.

By default the only source is the synthetic live feed: one shared run feeds
the module, and every page shows its results from the start.
"""

from pswamp_core.datagateway import DataGateway, gateway_from_env
from pswamp_core.pipeline import Pipeline

from ..__PKG__ import __NAME__Module

APP = "__SLUG__"

DATA_CLIENTS_VARIABLE = "__UPPER___DATA_CLIENTS"
DEFAULT_DATA_CLIENTS = "live:pswamp_modules.sources.live_client:LiveSyntheticClient"


def gateway() -> DataGateway:
    return gateway_from_env(DATA_CLIENTS_VARIABLE, DEFAULT_DATA_CLIENTS)


PIPELINE = Pipeline(APP, gateway, modules=(__NAME__Module,))
