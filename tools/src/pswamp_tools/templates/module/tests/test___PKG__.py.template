"""The __LABEL__ app's web API: the page's socket end to end, with the whole
server in-process. The module itself is tested beside its code, in
``modules/__SLUG__/tests/``."""

import pytest


@pytest.fixture
def server(monkeypatch):
    """The whole server, in-memory transport: the module is hosted in-process."""
    monkeypatch.delenv("PSWAMP_TRANSPORT", raising=False)
    from fastapi.testclient import TestClient

    import server as server_module

    with TestClient(server_module.app) as client:
        yield client


def test_the_page_s_socket_gets_results(server):
    with server.websocket_connect("/api/__SLUG__/ws?client_id=4242") as ws:
        for _ in range(200):
            state = ws.receive_json()
            if state["result"] is not None:
                break
    assert state["result"]["app"]["name"] == "__SLUG__"
    assert 40 < state["result"]["result"]["frequency_hz"] < 70
